# fwber-frontend npm resolution policy (v2.3.41)
#
# WHY: the React 18 -> 19 transition left several sub-dependencies with
# peer ranges that still declare `react: ^16||^17||^18` even though the
# installed versions run correctly under React 19 (validated: full build +
# runtime smoke on the Next 16 / React 19 tree). Strict peer resolution
# refuses the install outright (ERESOLVE), so we install with legacy peer
# semantics project-wide — deterministically, for every machine and CI run.
#
# Follow-up (TODO.md): move to the React-19-native majors as they land
# (react-leaflet 5, remaining @radix-ui pins), then remove this file.
legacy-peer-deps=true
