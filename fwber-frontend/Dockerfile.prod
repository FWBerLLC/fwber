# Multi-stage Production Dockerfile for fwber-frontend (Next.js 16 Standalone, Node 24)
# Build from repository root (`docker build -f fwber-frontend/Dockerfile.prod .`) so
# `outputFileTracingRoot` and root `VERSION` resolve identically to Hetzner production.
FROM node:24-alpine AS builder
WORKDIR /repo

COPY VERSION ./VERSION
COPY fwber-backend-ts/VERSION ./fwber-backend-ts/VERSION
COPY fwber-frontend/package*.json ./fwber-frontend/

WORKDIR /repo/fwber-frontend
ENV CYPRESS_INSTALL_BINARY=0
RUN npm ci --no-audit --no-fund

COPY fwber-frontend/ ./

ARG NEXT_PUBLIC_API_URL=https://api.fwber.online/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_WS_URL=https://ws.fwber.online
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL

ARG NEXT_PUBLIC_APP_URL=https://fwber.online
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

ARG NEXT_PUBLIC_FEATURE_CLIENT_FACE_BLUR
ENV NEXT_PUBLIC_FEATURE_CLIENT_FACE_BLUR=$NEXT_PUBLIC_FEATURE_CLIENT_FACE_BLUR

ARG NEXT_PUBLIC_FEATURE_FACE_REVEAL
ENV NEXT_PUBLIC_FEATURE_FACE_REVEAL=$NEXT_PUBLIC_FEATURE_FACE_REVEAL

ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY
ENV NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY

RUN npm run build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /repo/fwber-frontend/.next/standalone/ ./

EXPOSE 3000
CMD ["node", "fwber-frontend/server.js"]
